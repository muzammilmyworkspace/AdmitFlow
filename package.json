{
  "name": "admitflow",
  "version": "0.1.0",
  "private": true,
  "description": "AdmitFlow by SNZ Ventures — Say No to Consultants.",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--require ./scripts/win-legacy-junction-shim.cjs\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--require ./scripts/win-legacy-junction-shim.cjs\" next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "devdb:start": "node scripts/dev-db.mjs start",
    "devdb:stop": "node scripts/dev-db.mjs stop",
    "worker": "tsx src/worker/index.ts",
    "test:e2e": "playwright test",
    "test:api": "bash scripts/e2e.sh",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.767.0",
    "@aws-sdk/s3-request-presigner": "^3.767.0",
    "@prisma/client": "^6.6.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.5",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.42.0",
    "next": "15.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@playwright/test@1.63.0": true
  }
}
