# AdmitFlow environment configuration — see docs/38-environment-configuration.md
# Copy to .env.local for development. Never commit a real .env file.
# APP_ENV (not NODE_ENV) drives environment-specific validation — docs/54-decision-log.md D-8/D-11.

APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Postgres via Prisma). $0-phase default: Supabase free-tier Postgres,
# used ONLY as a connection string — Supabase Auth/Storage are never used (docs/54 D-11).
#
# On Supabase there are TWO connection strings and they are not interchangeable:
#   DATABASE_URL  -> the POOLER (port 6543). Runtime queries. On a serverless platform
#                    every invocation is its own process, so unpooled connections exhaust
#                    Postgres' limit long before traffic does. Append:
#                    ?pgbouncer=true&connection_limit=1
#   DIRECT_URL    -> the DIRECT connection (port 5432). Migrations only. The pooler runs
#                    pgbouncer in transaction mode, which has no session state, and the
#                    migration engine needs it. ---
DATABASE_URL=postgresql://user:password@localhost:5432/admitflow
# Unpooled connection, used only by `prisma migrate deploy`. On Supabase this is the
# direct (port 5432) URL; the pooler cannot run migrations. Locally it is the same as
# DATABASE_URL because a local Postgres has no pooler.
DIRECT_URL=postgresql://user:password@localhost:5432/admitflow

# --- Sessions / Auth (custom auth, not a third-party auth service — docs/54 D-2) ---
SESSION_SECRET=replace-with-a-64-char-random-hex-string
# Presented by the scheduler as: Authorization: Bearer <CRON_SECRET>
# Leave unset in development; the cron route refuses to run without it.
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Redis ($0-phase default: Upstash free tier).
# Rate limiting is backed by this. On a serverless platform the in-memory fallback is
# empty on every invocation, which means login and signup limits are not enforced at all —
# so a real Redis is a security requirement in production, not an optimisation. Upstash
# gives a rediss:// URL. ---
REDIS_URL=redis://localhost:6379

# --- Object storage: AWS S3 only (docs/54 D-1). Private buckets, no public ACLs. ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=admitflow-documents-dev
S3_SIGNED_URL_UPLOAD_TTL_SECONDS=120
S3_SIGNED_URL_DOWNLOAD_TTL_SECONDS=60

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Email / notifications. Resend by default (src/lib/notifications/mailer.ts).
# Without this key the app refuses to start in production: a student who never receives a
# verification link cannot use the product, and a silently dropped auth email leaves no
# trace that anything went wrong. ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@admitflow.example

# --- Feature gating ---
# Hard startup-validation failure whenever APP_ENV=production — docs/38-environment-configuration.md.
DEMO_MODE=false
